<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne : case (tâche) ou agenda (événement), titre, heure, pastille de liste. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="12dp">

        <FrameLayout
            android:id="@+id/check_area"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_check">

            <ImageView
                android:id="@+id/check_box"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_box_off" />

            <ImageView
                android:id="@+id/check_tick"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_tick"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/event_mark"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_calendar"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/planning_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/planning_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/dot"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/dot_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_fill" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_ring" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
